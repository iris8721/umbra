let s = "Hello, Umbra!"
print(string.format("[string] upper:        %s", string.upper(s)))
print(string.format("[string] lower:        %s", string.lower(s)))
print(string.format("[string] sub(1,5):     %s", string.sub(s, 1, 5)))
print(string.format("[string] sub(-5,-1):   %s", string.sub(s, -5, -1)))
print(string.format("[string] len:          %d", string.len(s)))
print(string.format("[string] rep x3 w sep: %s", string.rep("ab", 3, "-")))
print(string.format("[string] byte 'H':     %d", string.byte(s, 1)))
print(string.format("[string] char 65-70:   %s", string.char(65, 66, 67, 68, 69, 70)))
print(string.format("[string] find 'Umbra': %d", string.find(s, "Umbra")))
print(string.format("[string] format %%q:   %s", string.format("%q", "say \"hi\"\nbye")))

print(string.format("[method] upper:   %s", s:upper()))
print(string.format("[method] sub:     %s", s:sub(1, 5)))
print(string.format("[method] len:     %d", s:len()))
print(string.format("[method] chained: %s", s:sub(8, 12):upper()))

print(string.format("[math]   pi:          %.6f", math.pi))
print(string.format("[math]   sqrt(2):     %.6f", math.sqrt(2)))
print(string.format("[math]   floor(-1.7): %d",   math.floor(-1.7)))
print(string.format("[math]   ceil(-1.2):  %d",   math.ceil(-1.2)))
let int_part, frac_part = math.modf(3.75)
print(string.format("[math]   modf(3.75):  %d + %.2f", int_part, frac_part))
print(string.format("[math]   max(1,5,3):  %d", math.max(1, 5, 3)))
print(string.format("[math]   min(1,5,3):  %d", math.min(1, 5, 3)))
print(string.format("[math]   abs(-7):     %d", math.abs(-7)))
print(string.format("[math]   log(e):      %.6f", math.log(math.exp(1))))
print(string.format("[math]   type int:    %s", math.type(1)))
print(string.format("[math]   type float:  %s", math.type(1.0)))
print(string.format("[math]   type str:    %s", tostring(math.type("x"))))

var nums = {9, 3, 7, 1, 5, 2, 8, 4, 6}
table.sort(nums)
print("[table]  sorted asc:   " .. table.concat(nums, " "))

table.sort(nums, fn(a, b) { return a > b })
print("[table]  sorted desc:  " .. table.concat(nums, " "))

var words = {"cherry", "apple", "date", "banana", "elderberry"}
table.sort(words)
print("[table]  words sorted: " .. table.concat(words, ", "))

table.insert(words, "fig")
table.remove(words, 1)
print("[table]  insert+remove: " .. table.concat(words, ", "))

let first3 = {table.unpack(nums, 1, 3)}
print("[table]  unpack(1,3):  " .. table.concat(first3, " "))
