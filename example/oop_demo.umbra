let Vec2 = {}
Vec2.__index = Vec2

fn Vec2.new(x, y) {
    return setmetatable({x = x, y = y}, Vec2)
}

fn Vec2:len() {
    return math.sqrt(self.x * self.x + self.y * self.y)
}

fn Vec2:normalize() {
    let l = self:len()
    return Vec2.new(self.x / l, self.y / l)
}

fn Vec2:dot(other) {
    return self.x * other.x + self.y * other.y
}

fn Vec2:fmt() {
    return string.format("(%.3f, %.3f)", self.x, self.y)
}

Vec2.__add = fn(lhs, rhs) { return Vec2.new(lhs.x + rhs.x, lhs.y + rhs.y) }
Vec2.__sub = fn(lhs, rhs) { return Vec2.new(lhs.x - rhs.x, lhs.y - rhs.y) }
Vec2.__mul = fn(lhs, rhs) {
    if type(lhs) == "number" { return Vec2.new(lhs * rhs.x, lhs * rhs.y) }
    return Vec2.new(lhs.x * rhs, lhs.y * rhs)
}
Vec2.__unm = fn(v) { return Vec2.new(-v.x, -v.y) }
Vec2.__eq  = fn(a, b) { return a.x == b.x and a.y == b.y }

let a = Vec2.new(3.0, 4.0)
let b = Vec2.new(1.0, 2.0)

print("[vec2]   a       = " .. a:fmt())
print("[vec2]   b       = " .. b:fmt())

let sum = a + b
let diff = a - b
let scaled = a * 2.0
let neg = Vec2.__unm(a)

print("[vec2]   a + b   = " .. sum:fmt())
print("[vec2]   a - b   = " .. diff:fmt())
print("[vec2]   a * 2   = " .. scaled:fmt())
print("[vec2]   -a      = " .. neg:fmt())
print(string.format("[vec2]   |a|     = %.3f", a:len()))
print(string.format("[vec2]   a·b     = %.3f", a:dot(b)))
print("[vec2]   norm(a) = " .. a:normalize():fmt())
print("[vec2]   a == b? " .. tostring(a == b))

let ColorVec2 = setmetatable({}, {__index = Vec2})
ColorVec2.__index = ColorVec2

fn ColorVec2.new(x, y, color) {
    return setmetatable({x = x, y = y, color = color}, ColorVec2)
}

fn ColorVec2:fmt() {
    return string.format("%s@(%.2f, %.2f)", self.color, self.x, self.y)
}

let red  = ColorVec2.new(5.0, 0.0, "red")
let blue = ColorVec2.new(0.0, 3.0, "blue")

print("[color]  red    = " .. red:fmt())
print("[color]  blue   = " .. blue:fmt())
print(string.format("[color]  |red|  = %.3f  (inherited :len())", red:len()))

let combo = red + blue
print("[color]  r+b    = " .. combo:fmt())
