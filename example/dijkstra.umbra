@ Dijkstra's shortest path on a seeded 2000-node graph.
@ Tables-as-structs for edges and a hand-rolled binary min-heap
@ for the priority queue.
let NN = 2000
var seed = 999983
fn next_rand() {
    seed = (seed * 1103515245 + 12345) % 2147483648
    return seed
}

@ adjacency: adj[u] = { {v, w}, ... }; ~8 edges per node, deterministic
let adj = {}
for u = 1, NN { adj[u] = {} }
for u = 1, NN {
    let deg = 4 + next_rand() % 5
    for e = 1, deg {
        let v = 1 + next_rand() % NN
        if v != u {
            let w = 1 + next_rand() % 100
            table.insert(adj[u], { v, w })
        }
    }
}

@ binary min-heap of {dist, node}
let heap = {}
var hsize = 0
fn hpush(d, n) {
    hsize++
    heap[hsize] = { d, n }
    var i = hsize
    while i > 1 {
        let p = i // 2
        if heap[p][1] <= heap[i][1] { break }
        let tmp = heap[p]
        heap[p] = heap[i]
        heap[i] = tmp
        i = p
    }
}
fn hpop() {
    let top = heap[1]
    heap[1] = heap[hsize]
    heap[hsize] = none
    hsize--
    var i = 1
    while true {
        let l = 2 * i
        let r = 2 * i + 1
        var m = i
        if l <= hsize and heap[l][1] < heap[m][1] { m = l }
        if r <= hsize and heap[r][1] < heap[m][1] { m = r }
        if m == i { break }
        let tmp = heap[m]
        heap[m] = heap[i]
        heap[i] = tmp
        i = m
    }
    return top
}

let INF = math.maxinteger
let dist = {}
for u = 1, NN { dist[u] = INF }
dist[1] = 0
hpush(0, 1)
var visited = 0
while hsize > 0 {
    let item = hpop()
    let d = item[1]
    let u = item[2]
    if d == dist[u] {
        visited++
        for e = 1, #adj[u] {
            let v = adj[u][e][1]
            let w = adj[u][e][2]
            let nd = d + w
            if nd < dist[v] {
                dist[v] = nd
                hpush(nd, v)
            }
        }
    }
}

var sum = 0
var unreached = 0
var maxd = 0
for u = 1, NN {
    if dist[u] == INF {
        unreached++
    } else {
        sum = (sum + dist[u]) % 1000000007
        if dist[u] > maxd { maxd = dist[u] }
    }
}
print("visited: ${visited}")
print("unreached: ${unreached}")
print("dist sum: ${sum}")
print("max dist: ${maxd}")
